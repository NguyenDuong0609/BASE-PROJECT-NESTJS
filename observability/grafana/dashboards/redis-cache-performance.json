              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1
        }
      },
      "id": 43
    },
    {
      "title": "Evicted Keys",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(redis_evicted_keys_total[5m])",
          "legendFormat": "Evictions/s",
