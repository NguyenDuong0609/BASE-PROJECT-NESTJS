{
	"name": "boilerplate-nest-js",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "cross-env NODE_ENV=development nest start --watch",
		"docker:dev": "docker compose --env-file ./.env.dev -f docker-compose.dev.yml up",
		"docker:dev:config": "docker compose --env-file ./.env.dev -f docker-compose.dev.yml config",
		"docker:dev:remove": "docker compose --env-file ./.env.dev -f docker-compose.dev.yml down",
		"start:debug": "nest start --debug --watch",
		"start:prod": "cross-env NODE_ENV=production node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
		"test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles --watch",
		"test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"test:debug": "cross-env NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
		"postman:generate": "node scripts/generate-postman-collection.mjs",
		"migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
		"migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
		"migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
		"migration:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
		"bootstrap:admin:dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/database/seeds/bootstrap-admin.ts",
		"bootstrap:admin": "node dist/database/seeds/bootstrap-admin.js",
		"docker:prod": "docker compose --env-file ./.env.prod -f docker-compose.prod.yml up -d",
		"docker:prod:build": "docker compose --env-file ./.env.prod -f docker-compose.prod.yml build",
		"docker:prod:up": "docker compose --env-file ./.env.prod -f docker-compose.prod.yml up -d",
		"docker:prod:down": "docker compose --env-file ./.env.prod -f docker-compose.prod.yml down",
		"docker:prod:logs": "docker compose --env-file ./.env.prod -f docker-compose.prod.yml logs -f",
		"docker:prod:config": "docker compose --env-file ./.env.prod -f docker-compose.prod.yml config"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1119.0",
		"@aws-sdk/s3-request-presigner": "^3.1119.0",
		"@nestjs-modules/mailer": "^3.0.2",
		"@nestjs/bullmq": "^12.0.0",
		"@nestjs/common": "^12.1.2",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.1.2",
		"@nestjs/jwt": "^12.0.2",
		"@nestjs/mapped-types": "^12.0.0",
		"@nestjs/passport": "^12.0.0",
		"@nestjs/platform-express": "^12.1.2",
		"@nestjs/swagger": "^12.0.2",
		"@nestjs/terminus": "^12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@nestjs/typeorm": "^12.0.2",
		"bcryptjs": "^2.4.3",
		"bullmq": "^6.3.11",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.0",
		"dotenv": "^18.0.6",
		"handlebars": "^4.7.10",
		"helmet": "^8.3.0",
		"ioredis": "^5.11.1",
		"joi": "^17.9.0",
		"nestjs-i18n": "^10.8.5",
		"nestjs-pino": "^5.3.1",
		"nodemailer": "^10.0.15",
		"otplib": "^13.5.0",
		"passport": "^0.6.0",
		"passport-google-oauth20": "^2.0.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.11.3",
		"pino-pretty": "^13.2.0",
		"prom-client": "^15.1.3",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.2.0",
		"typeorm": "^0.3.20",
		"uuid": "11.1.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^17.5.0",
		"@commitlint/config-conventional": "^17.4.4",
		"@golevelup/ts-jest": "^0.3.7",
		"@nestjs/cli": "^12.0.8",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.1.2",
		"@types/bcryptjs": "^2.4.2",
		"@types/express": "^5.0.3",
		"@types/jest": "30.0.0",
		"@types/multer": "^1.4.7",
		"@types/node": "^24.19.1",
		"@types/nodemailer": "^7.0.12",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/passport-jwt": "^3.0.8",
		"@types/passport-local": "^1.0.35",
		"@types/supertest": "^7.2.1",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"cross-env": "^10.1.0",
		"eslint": "^8.0.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"husky": "^8.0.3",
		"jest": "30.5.2",
		"pg-mem": "^3.0.14",
		"prettier": "^3.9.9",
		"source-map-support": "^0.5.20",
		"supertest": "^7.3.1",
		"ts-jest": "29.4.14",
		"ts-loader": "^9.2.3",
		"ts-node": "^10.0.0",
		"tsconfig-paths": "4.1.1",
		"typescript": "^6.0.3"
	},
	"overrides": {
		"body-parser": "1.20.6",
		"file-type": "21.3.2",
		"js-yaml": "4.3.2",
		"lodash": "4.18.1",
		"multer": "2.4.0",
		"qs": "6.16.0",
		"nestjs-i18n": {
			"chokidar": "4.0.3"
		},
		"uuid": "11.1.1"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1",
			"^@modules/(.*)$": "<rootDir>/modules/$1",
			"^@configs/(.*)$": "<rootDir>/configs/$1",
			"^@config/(.*)$": "<rootDir>/configs/$1",
			"^@repositories/(.*)$": "<rootDir>/repositories/$1",
			"^@test-utils$": "<rootDir>/test-utils"
		},
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"testPathIgnorePatterns": [
			"/node_modules/",
			"<rootDir>/../dist/",
			"<rootDir>/modules/auth/test/auth.service.spec.ts",
			"<rootDir>/modules/auth/test/auth.controller.spec.ts"
		],
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"transformIgnorePatterns": [
			"node_modules/(?!(?:@nestjs/bullmq|@nestjs/bull-shared|bullmq)/)"
		],
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
