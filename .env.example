# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env.dev for local/dev or .env.prod for production
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
APP_IMAGE=flash-cards-api
# Number of trusted reverse-proxy hops; keep 0 unless deployed behind a known proxy chain.
TRUST_PROXY_HOPS=0
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Database (PostgreSQL)
# Use 'localhost' for local running, or 'postgres_db' for Docker network
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=nestjs_boilerplate
DB_LOGGING=false
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000

# Redis
# Use 'localhost' for local running, or 'redis' for Docker network
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
APP_CACHE_PREFIX=nestjs-base

# Observability & Monitoring (Loki, Prometheus, Grafana, pgAudit)
ENABLE_METRICS=true
ENABLE_PGAUDIT=true
AUDIT_RETENTION_DAYS=0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3001

# Optional Integrations / Feature Flags
ENABLE_S3=false
ENABLE_GOOGLE_OAUTH=false
ENABLE_FLASH_CARDS=false
ENABLE_COLLECTIONS=false
ENABLE_TOPICS=false
ENABLE_CHECKIN=false
ENABLE_COMMENTS=false
ENABLE_FLASH_CARD_STATES=false
ENABLE_TWO_FACTOR=false
TWO_FACTOR_ENCRYPTION_KEY=
ENABLE_ACCOUNT_EMAIL_FLOWS=false
ENABLE_STUDENT_CARD_UPLOADS=false
REQUIRE_VERIFIED_EMAIL=false

# SMTP Settings (Required only when account email flows are enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Application

# Frontend & CORS
# In production, FRONTEND_URL must use HTTPS protocol
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# Swagger UI (Must be disabled in production)
SWAGGER_ENABLED=true
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=your_secure_swagger_password_min_16_chars

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# AWS S3 (Required only when ENABLE_S3=true)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Google OAuth (Required only when ENABLE_GOOGLE_OAUTH=true)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT Authentication (Secrets must be >= 32 chars and distinct)
# In production, placeholders (e.g. your_*, change_me, example) will be rejected
JWT_ACCESS_TOKEN_SECRET=your_very_long_and_secure_secret_key_here_at_least_32_characters
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_SECRET=another_very_long_and_secure_secret_key_here_at_least_32_characters
JWT_REFRESH_TOKEN_EXPIRATION=7d
