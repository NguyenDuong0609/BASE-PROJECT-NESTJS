# Application
NODE_ENV=development
PORT=3000
# Number of trusted reverse-proxy hops; keep 0 unless deployed behind a known proxy chain.
TRUST_PROXY_HOPS=0
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=nestjs_boilerplate
DB_LOGGING=false
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
APP_CACHE_PREFIX=nestjs-base

# Optional integrations/features
ENABLE_S3=false
ENABLE_GOOGLE_OAUTH=false
ENABLE_FLASH_CARDS=false
ENABLE_COLLECTIONS=false
ENABLE_TOPICS=false
ENABLE_CHECKIN=false
ENABLE_COMMENTS=false
ENABLE_FLASH_CARD_STATES=false
ENABLE_METRICS=false
AUDIT_RETENTION_DAYS=0
ENABLE_TWO_FACTOR=false
TWO_FACTOR_ENCRYPTION_KEY=
ENABLE_PGAUDIT=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
ENABLE_ACCOUNT_EMAIL_FLOWS=false
ENABLE_STUDENT_CARD_UPLOADS=false
REQUIRE_VERIFIED_EMAIL=false
# Generic SMTP settings (required only when account email flows are enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Application
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=false
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=your-bucket-name

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT
JWT_ACCESS_TOKEN_SECRET=your_very_long_and_secure_secret_key_here_at_least_32_characters
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_SECRET=another_very_long_and_secure_secret_key_here_at_least_32_characters
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Frontend
FRONTEND_URL=http://localhost:4200
